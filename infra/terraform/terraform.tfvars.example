project_name               = "niitsyllabriq"
environment                = "production"
region                     = "blr1"
spaces_region              = "blr1"
vpc_ip_range               = "10.30.0.0/16"
doks_cluster_name          = "niitsyllabriq-prod"
doks_version               = "1.32.2-do.0"
enable_doks_ha             = true
app_node_size              = "s-2vcpu-4gb"
app_node_min_count         = 3
app_node_max_count         = 6
worker_node_size           = "s-2vcpu-4gb"
worker_node_min_count      = 1
worker_node_max_count      = 4
postgres_engine_version    = "16"
postgres_size              = "db-s-1vcpu-2gb"
postgres_node_count        = 2
postgres_database_name     = "niit_design_automation"
postgres_app_user          = "niit_app"
container_registry_name    = "niitsyllabriq-registry"
spaces_training_bucket     = "niitsyllabriq-training-prod"
spaces_requirements_bucket = "niitsyllabriq-requirements-prod"
spaces_exports_bucket      = "niitsyllabriq-exports-prod"
enable_llama_gpu           = false
llama_gpu_name             = "niitsyllabriq-llama-prod"
llama_gpu_size             = "g-rtx4000-1-16gb"
llama_gpu_image            = "ubuntu-24-04-x64"
admin_ssh_key_ids          = ["replace-with-your-ssh-key-id"]
tags                       = ["niitsyllabriq", "production"]
