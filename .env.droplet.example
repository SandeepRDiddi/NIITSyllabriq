APP_NAME=NIIT Design Automation
ENVIRONMENT=production

POSTGRES_USER=niit
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=niit_design_automation
DATABASE_URL=postgresql+psycopg://niit:change-this-postgres-password@postgres:5432/niit_design_automation

LLM_PROVIDER=groq
GROQ_API_KEY=paste-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Keep droplet training lightweight for demo/testing.
TRAINING_USE_LLM_NORMALIZATION=false
TRAINING_EMBED_ON_UPLOAD=false
TRAINING_CHUNK_MAX_CHARS=1800
TRAINING_MAX_CHUNKS_PER_DOCUMENT=40

# Optional local fallback metadata. No Ollama container is started in droplet demo mode.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_SECONDS=10

SIMILARITY_THRESHOLD=0.78
PRIMARY_REVIEWERS=primary.reviewer@niit.com
FINAL_REVIEWERS=final.reviewer1@niit.com,final.reviewer2@niit.com
EXPORT_DIR=app/storage/designs
REQUIREMENT_DIR=app/storage/requirements
TEMPLATE_DIR=app/templates/designs

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ALLOWED_ORIGINS=http://159.89.164.3:5173
VITE_API_BASE_URL=http://159.89.164.3:8000
